{
  "manifest_version": 3,
  "name": "MatchFetch",
  "version": "1.1.3",
  "description": "Fetch and explore your AncestryDNA match data. 23andMe support coming soon.",
  "author": "Omar Nunez",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MatchFetch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["scripting", "unlimitedStorage", "notifications", "tabs"],
  "host_permissions": [
    "https://www.ancestry.com/*"
  ]
}
